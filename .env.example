# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL, used for canonical links, sitemap, and email manage links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB. Points at the Docker container on host port 27018 (see compose.yaml)
# with this project's own database name, ecopure.
MONGODB_URI=mongodb://127.0.0.1:27018/ecopure

# Resend (email). A placeholder key is fine for local development — email sends
# are logged instead of sent unless a real key is set. Production fails closed.
RESEND_API_KEY=re_placeholder_local_only
EMAIL_FROM=EcoPure Cleaning <onboarding@resend.dev>
# Where new request notices land. Editable later as a site setting.
OWNER_NOTIFY_EMAIL=owner@example.com

# --- Admin / auth ---
# Session and guest-token signing secret (jose, HS256). Generate one:
# `openssl rand -base64 48`. Production fails closed on the placeholder.
JWT_SECRET=change-me-change-me-change-me-change-me
# Seeded owner account; change the password after first sign-in.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=EcoPure owner

# Passkeys (WebAuthn). rpID is the registrable domain; origin is scheme+host.
# Defaults target localhost; set these per environment in production.
WEBAUTHN_RP_NAME=EcoPure Cleaning
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ImageKit (owner-uploaded gallery and before/after images). Placeholder keys
# disable upload in development. Production fails closed on the placeholder.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_placeholder
IMAGEKIT_PRIVATE_KEY=private_placeholder
